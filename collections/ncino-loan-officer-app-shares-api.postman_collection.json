                "value": "<string>"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"<string,null-email>\",\n  \"phone\": \"<string,null>\",\n  \"destination_name\": \"<string,null>\",\n  \"partner_id\": \"<string,null-uuid>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
