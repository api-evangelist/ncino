{
  "opencollection": "1.0.0",
  "info": {
    "name": "nCino Mortgage Region Images API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Region Images",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Update a region's image",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.ncinomortgage.com/regions/:region_id/images/:image_key",
            "headers": [
              {
                "name": "X-Api-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "image_key",
                "value": "",
                "type": "path",
                "description": "Image to be updated."
              },
              {
                "name": "region_id",
                "value": "",
                "type": "path",
                "description": "Region ID."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Uploads images to a <<glossary:region>>. Available images and their image_keys, along with the supported file types and sizes are in the table below.\n\n> 🙇 Heads up!\n**All image file uploads should be base64 encoded.**\n<table border=1px cellpadding=5px>\n\t<tr>\n\t\t<th>image_key</th>\n\t\t<th>Supported File Types</th>\n\t\t<th>Image Dimensions</th>\n\t</tr>\n\t<tr>\n\t\t<td>logo</td>\n\t\t<td>\n\t\t\t<ul>\n\t\t\t\t<li>.jpeg</li>\n\t\t\t\t<li>.jpg</li>\n\t\t\t\t<li>.png</li>\n\t\t\t</ul>\n\t\t</td>\n\t\t<td>1000x313</td>\n\t</tr>\n\t<tr>\n\t\t<td>app_"
        },
        {
          "info": {
            "name": "Delete a region's image",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.ncinomortgage.com/regions/:region_id/images/:image_key",
            "headers": [
              {
                "name": "X-Api-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "image_key",
                "value": "",
                "type": "path",
                "description": "Image to be deleted."
              },
              {
                "name": "region_id",
                "value": "",
                "type": "path",
                "description": "Region ID."
              }
            ]
          },
          "docs": "This endpoint will delete a <<glossary:region>>'s image."
        }
      ]
    }
  ],
  "bundled": true
}