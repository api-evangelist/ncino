{
  "opencollection": "1.0.0",
  "info": {
    "name": "nCino Mortgage Company Reports API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Company Reports",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Generate a company report",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.ncinomortgage.com/companies/:company_id/reports",
            "headers": [
              {
                "name": "X-Api-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "company_id",
                "value": "",
                "type": "path",
                "description": "Company ID."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "This endpoint will generate a <<glossary:company>> report.\n\nThe report will be generated as an <<glossary:asynchronous job>> and can be accessed when the job returned in the response has successfully completed."
        },
        {
          "info": {
            "name": "Download a report for a company",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.ncinomortgage.com/companies/:company_id/reports/:report_id",
            "headers": [
              {
                "name": "X-Api-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "company_id",
                "value": "",
                "type": "path",
                "description": "Scope response to company_id"
              },
              {
                "name": "report_id",
                "value": "",
                "type": "path",
                "description": "Scope response to report_id"
              }
            ]
          },
          "docs": "This endpoint will download a report for a <<glossary:company>>."
        }
      ]
    }
  ],
  "bundled": true
}