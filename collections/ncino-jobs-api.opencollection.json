{
  "opencollection": "1.0.0",
  "info": {
    "name": "nCino Mortgage Jobs API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Jobs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve a job record",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.ncinomortgage.com/jobs/:job_id",
            "headers": [
              {
                "name": "X-Api-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "job_id",
                "value": "",
                "type": "path",
                "description": "Job ID."
              }
            ]
          },
          "docs": "This endpoint will retrieve an <<glossary:asynchronous job>> record."
        }
      ]
    }
  ],
  "bundled": true
}