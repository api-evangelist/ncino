          "id": "40420048-fc63-4f96-98cc-08b97852674e",
          "name": "🚧 Retrieve all permissions held by a user, resolved across all assigned roles. (BETA)",
          "request": {
            "name": "🚧 Retrieve all permissions held by a user, resolved across all assigned roles. (BETA)",
            "description": {
              "content": "> 🚧 Under construction\n> **This endpoint is in beta.** Functionality may change without notice, support is limited, and use in production is not recommended. Your feedback is appreciated.\n\nReturns the union of permissions across every role assigned to the user,\ndeduplicated and sorted, as an array of permission key strings.",
              "type": "text/plain"
            },
