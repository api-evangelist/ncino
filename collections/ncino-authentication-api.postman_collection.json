                      "disabled": false,
                      "description": {
                        "content": "(Required) The OAuth2 grant type being used.",
                        "type": "text/plain"
                      },
                      "key": "grant_type",
                      "value": "authorization_code"
                    },
                    {
                      "disabled": false,
                      "description": {
                        "content": "Required when grant_type is `authorization_code`. The authorization code issued for your org API client (returned as `clientId`/`id` when the API client was authorized for the org).",
                        "type": "text/plain"
                      },
                      "key": "code",
                      "value": "459f521f-f2fa-4230-a704-46147ac8as7e"
                    }
                  ]
                }
              },
              "status": "OK",
              "code": 200,
