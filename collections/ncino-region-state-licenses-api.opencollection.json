{
  "opencollection": "1.0.0",
  "info": {
    "name": "nCino Mortgage Region State Licenses API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Region State Licenses",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve all region state licenses",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.ncinomortgage.com/regions/:region_id/state_licenses",
            "headers": [
              {
                "name": "X-Api-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "region_id",
                "value": "",
                "type": "path",
                "description": "Region ID."
              },
              {
                "name": "state",
                "value": "",
                "type": "query",
                "description": "State by which to filter state licenses."
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "The page to retrieve."
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "The number of records returned in each page."
              },
              {
                "name": "created_after",
                "value": "",
                "type": "query",
                "description": "The date which a resource must be created after to be returned."
              },
              {
                "name": "created_before",
                "value": "",
                "type": "query",
                "description": "The date which a resource must be created before to be returned."
              },
              {
                "name": "updated_after",
                "value": "",
                "type": "query",
                "description": "The date which a resource must be updated after to be returned."
              },
              {
                "name": "updated_before",
                "value": "",
                "type": "query",
                "description": "The date which a resource must be updated before to be returned."
              }
            ]
          },
          "docs": "Retrieve all <<glossary:state license>>s for the given <<glossary:region>>."
        },
        {
          "info": {
            "name": "Create a region's state license",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.ncinomortgage.com/regions/:region_id/state_licenses",
            "headers": [
              {
                "name": "X-Api-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "region_id",
                "value": "",
                "type": "path",
                "description": "Region ID."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a <<glossary:state license>> for the given <<glossary:region>>."
        },
        {
          "info": {
            "name": "Retrieve a region state license",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.ncinomortgage.com/regions/:region_id/state_licenses/:state_license_id",
            "headers": [
              {
                "name": "X-Api-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "region_id",
                "value": "",
                "type": "path",
                "description": "Region ID."
              },
              {
                "name": "state_license_id",
                "value": "",
                "type": "path",
                "description": "State license ID."
              }
            ]
          },
          "docs": "Retrieve a <<glossary:state license>> for the given <<glossary:region>>."
        },
        {
          "info": {
            "name": "Update a region state license",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.ncinomortgage.com/regions/:region_id/state_licenses/:state_license_id",
            "headers": [
              {
                "name": "X-Api-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "region_id",
                "value": "",
                "type": "path",
                "description": "Region ID."
              },
              {
                "name": "state_license_id",
                "value": "",
                "type": "path",
                "description": "State license ID."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a <<glossary:state license>> for the given <<glossary:region>>."
        },
        {
          "info": {
            "name": "Delete a region state license",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.ncinomortgage.com/regions/:region_id/state_licenses/:state_license_id",
            "headers": [
              {
                "name": "X-Api-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "region_id",
                "value": "",
                "type": "path",
                "description": "Region ID."
              },
              {
                "name": "state_license_id",
                "value": "",
                "type": "path",
                "description": "State license ID."
              }
            ]
          },
          "docs": "Delete a <<glossary:state license>> from the given <<glossary:region>>."
        }
      ]
    }
  ],
  "bundled": true
}