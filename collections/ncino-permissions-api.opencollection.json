{
  "opencollection": "1.0.0",
  "info": {
    "name": "nCino Mortgage Permissions API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Permissions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "🚧 Retrieve all permissions (BETA)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.ncinomortgage.com/permissions",
            "headers": [
              {
                "name": "X-Api-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "group_key",
                "value": "",
                "type": "query",
                "description": "Filter <<glossary:permission>>s by category (group key)."
              },
              {
                "name": "name",
                "value": "",
                "type": "query",
                "description": "Filter <<glossary:permission>>s by name."
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "The page to retrieve."
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "The number of records returned in each page."
              }
            ]
          },
          "docs": "> 🚧 Under construction\n> **This endpoint is in beta.** Functionality may change without notice, support is limited, and use in production is not recommended. Your feedback is appreciated.\n\nRetrieve all permissions that can be granted to a role, optionally filtered by name or category."
        },
        {
          "info": {
            "name": "🚧 Retrieve the permissions included in a given default role template (BETA)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.ncinomortgage.com/permissions/templates/:template_key",
            "headers": [
              {
                "name": "X-Api-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "template_key",
                "value": "",
                "type": "path",
                "description": "The identifier for the default role template."
              }
            ]
          },
          "docs": "> 🚧 Under construction\n> **This endpoint is in beta.** Functionality may change without notice, support is limited, and use in production is not recommended. Your feedback is appreciated.\n\nRetrieve the permissions included in a given default role template."
        }
      ]
    }
  ],
  "bundled": true
}