            "url": "https://api.ncinomortgage.com/branches/:branch_id/state_licenses/:state_license_id",
            "headers": [
              {
                "name": "X-Api-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "branch_id",
                "value": "",
                "type": "path",
                "description": "Branch ID."
              },
              {
                "name": "state_license_id",
                "value": "",
                "type": "path",
                "description": "State license ID."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "This endpoint will update a <<glossary:branch>> <<glossary:state license>>."
        },
        {
          "info": {
            "name": "Delete a branch state license",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.ncinomortgage.com/branches/:branch_id/state_licenses/:state_license_id",
            "headers": [
              {
                "name": "X-Api-Version",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "branch_id",
                "value": "",
                "type": "path",
                "description": "Branch ID."
              },
              {
                "name": "state_license_id",
                "value": "",
                "type": "path",
                "description": "State license ID."
              }
            ]
          },
          "docs": "This endpoint will delete a <<glossary:branch>> <<glossary:state license>>."
        }
      ]
    }
  ],
  "bundled": true
}